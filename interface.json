{
    "interface_version": 2,
    "name": "FOS",
    "label": "$project.label",
    "languages": {
        "zh_cn": "./i18n/zh_cn.json",
        "zh_tw": "./i18n/zh_tw.json",
        "ja_jp": "./i18n/ja_jp.json",
        "en_us": "./i18n/en_us.json"
    },
    "title": "$project.label",
    "mirrorchyan_rid": "MAA_Punish",
    "github": "https://github.com/overflow65537/MAA_Punish",
    "license": "./LICENSE",
    "contact": "$contact",
    "welcome": "$welcome",
    "description": "$project.description",
    "icon": "./logo.png",
    "controller": [
        {
            "name": "Android",
            "type": "Adb",
            "description": "$controller.Android.description",
            "label": "$controller.Android.label"
        },
        {
            "name": "Win32-Window",
            "description": "$controller.Win32-Window.description",
            "type": "Win32",
            "win32": {
                "class_regex": "UnityWndClass",
                "window_regex": "^(战双帕弥什|戰雙帕彌什)$",
                "screencap": "Background",
                "mouse": "SendMessageWithCursorPos",
                "keyboard": "SendMessageWithCursorPos"
            },
            "permission_required": true,
            "attach_resource_path": [
                "./resource/pgr_win32"
            ],
            "label": "$controller.Win32-Window.label"
        },
        {
            "name": "Win32-Window-Background",
            "description": "$controller.Win32-Window-Background.description",
            "type": "Win32",
            "win32": {
                "class_regex": "UnityWndClass",
                "window_regex": "^(战双帕弥什|戰雙帕彌什)$",
                "screencap": "PrintWindow",
                "mouse": "SendMessageWithWindowPos",
                "keyboard": "SendMessageWithWindowPos"
            },
            "permission_required": true,
            "attach_resource_path": [
                "./resource/pgr_win32"
            ],
            "label": "$controller.Win32-Window-Background.label"
        },
        {
            "name": "Win32-Window-Front",
            "description": "$controller.Win32-Window-Front.description",
            "type": "Win32",
            "win32": {
                "class_regex": "UnityWndClass",
                "window_regex": "^(战双帕弥什|戰雙帕彌什)$",
                "screencap": "ScreenDC",
                "mouse": "Seize",
                "keyboard": "Seize"
            },
            "permission_required": true,
            "attach_resource_path": [
                "./resource/pgr_win32"
            ],
            "label": "$controller.Win32-Window-Front.label"
        },
        {
            "name": "PlayCover",
            "type": "PlayCover",
            "description": "$controller.PlayCover.description",
            "playcover": {
                "uuid": "maa.playcover"
            },
            "attach_resource_path": [
                "./resource/playcover"
            ],
            "label": "$controller.PlayCover.label"
        }
    ],
    "agent": {
        "child_exec": "python",
        "child_args": [
            "{PROJECT_DIR}/agent/main.py"
        ]
    },
    "resource": [
        {
            "name": "zh_CN",
            "description": "$resource.zh_CN.description",
            "path": [
                "./resource/base"
            ],
            "label": "$resource.zh_CN.label"
        },
        {
            "name": "zh_TW",
            "description": "$resource.zh_TW.description",
            "path": [
                "./resource/base",
                "./resource/zh_TW"
            ],
            "label": "$resource.zh_TW.label"
        },
        {
            "name": "ja_JP",
            "label": "$resource.ja_JP.label",
            "description": "$resource.ja_JP.description",
            "path": [
                "./resource/base",
                "./resource/ja_JP"
            ]
        },
        {
            "name": "en_US",
            "label": "$resource.en_US.label",
            "description": "$resource.en_US.description",
            "path": [
                "./resource/base",
                "./resource/en_US"
            ]
        }
    ],
    "task": [],
    "group": [
        {
            "name": "daily",
            "label": "$group.daily.label",
            "description": "$group.daily.description",
            "default_expand": true
        },
        {
            "name": "roguelike",
            "label": "$group.roguelike.label",
            "description": "$group.roguelike.description",
            "default_expand": true
        },
        {
            "name": "tools",
            "label": "$group.tools.label",
            "description": "$group.tools.description",
            "default_expand": true
        }
    ],
    "preset": [
        {
            "name": "preset_daily",
            "label": "$preset.preset_daily.label",
            "task": [
                {
                    "name": "进入游戏",
                    "enabled": true
                },
                {
                    "name": "兑换码",
                    "enabled": true
                },
                {
                    "name": "指挥局",
                    "enabled": true
                },
                {
                    "name": "拟真围剿",
                    "enabled": true
                },
                {
                    "name": "诺曼复兴战",
                    "enabled": true
                },
                {
                    "name": "幻痛囚笼",
                    "enabled": true
                },
                {
                    "name": "纷争战区",
                    "enabled": true
                },
                {
                    "name": "历战映射",
                    "enabled": true
                },
                {
                    "name": "刷A级碎片",
                    "enabled": false
                },
                {
                    "name": "领取体力",
                    "enabled": true
                },
                {
                    "name": "领取邮件",
                    "enabled": true
                },
                {
                    "name": "购买物品",
                    "enabled": true,
                    "option": {
                        "选择物品": "逆元碎片-普通商店"
                    }
                },
                {
                    "name": "购买物品",
                    "enabled": true,
                    "option": {
                        "选择物品": "涂装设计草稿-宿舍商店"
                    }
                },
                {
                    "name": "购买物品",
                    "enabled": true,
                    "option": {
                        "选择物品": "武器设计草稿-宿舍商店"
                    }
                },
                {
                    "name": "宿舍任务",
                    "enabled": true
                },
                {
                    "name": "拟战场域",
                    "enabled": true
                },
                {
                    "name": "维系者行动",
                    "enabled": true
                },
                {
                    "name": "领取任务",
                    "enabled": true
                },
                {
                    "name": "战令",
                    "enabled": true
                },
                {
                    "name": "结束游戏",
                    "enabled": true
                }
            ]
        },
        {
            "name": "preset_roguelike",
            "label": "$preset.preset_roguelike.label",
            "description": "$preset.preset_roguelike.description",
            "task": [
                {
                    "name": "宣叙妄响",
                    "enabled": false
                },
                {
                    "name": "厄愿潮声",
                    "enabled": false
                },
                {
                    "name": "矩阵循生",
                    "enabled": false
                },
                {
                    "name": "寒境曙光",
                    "enabled": false
                },
                {
                    "name": "神寂启示录",
                    "enabled": false
                },
                {
                    "name": "雾夜镇魂曲",
                    "enabled": false
                }
            ]
        },
        {
            "name": "preset_tools",
            "label": "$preset.preset_tools.label",
            "description": "$preset.preset_tools.description",
            "task": [
                {
                    "name": "手动更新角色缓存",
                    "enabled": false
                },
                {
                    "name": "洗词缀",
                    "enabled": false
                },
                {
                    "name": "链合回路",
                    "enabled": false
                },
                {
                    "name": "战斗辅助",
                    "enabled": false
                },
                {
                    "name": "Screencap",
                    "enabled": false
                }
            ]
        }
    ],
    "import": [
        "./options/global_option.json",
        "./tasks/进入游戏.json",
        "./tasks/兑换码.json",
        "./tasks/指挥局.json",
        "./tasks/拟真围剿.json",
        "./tasks/诺曼复兴战.json",
        "./tasks/幻痛囚笼.json",
        "./tasks/纷争战区.json",
        "./tasks/历战映射.json",
        "./tasks/刷A级碎片.json",
        "./tasks/领取体力.json",
        "./tasks/领取邮件.json",
        "./tasks/购买物品.json",
        "./tasks/宿舍任务.json",
        "./tasks/拟战场域.json",
        "./tasks/维系者行动.json",
        "./tasks/领取任务.json",
        "./tasks/战令.json",
        "./tasks/结束游戏.json",
        "./tasks/手动更新角色缓存.json",
        "./tasks/手动更新组件区域.json",
        "./tasks/洗词缀.json",
        "./tasks/链合回路.json",
        "./tasks/战斗辅助.json",
        "./tasks/宣叙妄响.json",
        "./tasks/厄愿潮声.json",
        "./tasks/矩阵循生.json",
        "./tasks/寒境曙光.json",
        "./tasks/神寂启示录.json",
        "./tasks/雾夜镇魂曲.json",
        "./tasks/Screencap.json"
    ]
}