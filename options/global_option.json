    "option": {
        "角色缓存更新频率": {
            "label": "$option.角色缓存更新频率.label",
            "description": "$option.角色缓存更新频率.description",
            "type": "select",
            "cases": [
                {
                    "name": "每周",
                    "pipeline_override": {
                        "是否需要缓存": {
                            "recognition": {
                                "param": {
                                    "custom_recognition_param": {
                                        "update_frequency": "weekly"
                                    }
                                }
                            }
                        },
                        "选择角色程序": {
                            "attach": {
                                "update_frequency": "weekly"
                            }
                        },
                        "选择角色程序_onlyNode": {
                            "attach": {
                                "update_frequency": "weekly"
                            }
                        },
                        "选择角色程序_矩阵循生": {
                            "attach": {
                                "update_frequency": "weekly"
                            }
                        }
                    },
                    "label": "$case.角色缓存更新频率.每周"
                },
                {
                    "name": "每月",
                    "pipeline_override": {
                        "是否需要缓存": {
                            "recognition": {
                                "param": {
                                    "custom_recognition_param": {
                                        "update_frequency": "monthly"
                                    }
                                }
                            }
                        },
                        "选择角色程序": {
                            "attach": {
                                "update_frequency": "monthly"
                            }
                        },
                        "选择角色程序_onlyNode": {
                            "attach": {
                                "update_frequency": "monthly"
                            }
                        },
                        "选择角色程序_矩阵循生": {
                            "attach": {
                                "update_frequency": "monthly"
                            }
                        }
                    },
                    "label": "$case.角色缓存更新频率.每月"
                },
                {
                    "name": "永不过期",
                    "pipeline_override": {
                        "是否需要缓存": {
                            "recognition": {
                                "param": {
                                    "custom_recognition_param": {
                                        "update_frequency": "never"
                                    }
                                }
                            }
                        },
                        "选择角色程序": {
                            "attach": {
                                "update_frequency": "never"
                            }
                        },
                        "选择角色程序_onlyNode": {
                            "attach": {
                                "update_frequency": "never"
                            }
                        },
                        "选择角色程序_矩阵循生": {
                            "attach": {
                                "update_frequency": "never"
                            }
                        }
                    },
                    "label": "$case.角色缓存更新频率.永不过期"
