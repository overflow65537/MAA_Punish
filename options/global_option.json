            ]
        },
        "多账号缓存": {
            "label": "$option.多账号缓存.label",
            "description": "$option.多账号缓存.description",
            "type": "switch",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "option": [
                        "角色缓存账号前缀"
                    ]
                },
                {
                    "name": "No"
                }
            ]
        },
        "缓存组件信息": {
            "label": "$option.缓存组件信息.label",
            "description": "$option.缓存组件信息.description",
            "type": "switch",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "覆盖布局菜单": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "覆盖布局菜单": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "角色缓存账号前缀": {
            "label": "$option.角色缓存账号前缀.label",
            "description": "$option.角色缓存账号前缀.description",
            "type": "input",
            "inputs": [
                {
                    "name": "账号前缀",
                    "label": "$input.角色缓存账号前缀.账号前缀.label",
                    "description": "$input.角色缓存账号前缀.账号前缀.description",
                    "default": "main",
                    "pipeline_type": "string",
                    "verify": "^[A-Za-z0-9_\\u4e00-\\u9fff\\-]{1,32}$",
                    "pattern_msg": "$input.角色缓存账号前缀.账号前缀.pattern_msg"
                }
            ],
            "pipeline_override": {
                "是否需要缓存": {
                    "recognition": {
                        "param": {
                            "custom_recognition_param": {
                                "cache_prefix": "{账号前缀}"
                            }
                        }
                    }
                },
                "选择角色程序": {
                    "attach": {
                        "cache_prefix": "{账号前缀}"
                    }
                },
                "选择角色程序_onlyNode": {
                    "attach": {
                        "cache_prefix": "{账号前缀}"
                    }
                },
                "选择角色程序_矩阵循生": {
                    "attach": {
                        "cache_prefix": "{账号前缀}"
                    }
                },
                "缓存角色程序": {
                    "attach": {
                        "cache_prefix": "{账号前缀}"
                    }
                }
            }
        },
