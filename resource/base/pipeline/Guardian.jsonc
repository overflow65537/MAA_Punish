{
    "维系者行动": {
        "next": [
            "行动上限",
            "无需任务",
            "[JumpBack]开始行动",
            "[JumpBack]打开维系者行动",
            "[JumpBack]打开任务",
            "[JumpBack]意外点击_主界面"
        ]
    },
    "无需任务": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "战斗任务",
                    "废弃仓库",
                    "支援箱"
                ]
            }
        },
        "next": [
            "返回主菜单"
        ]
    },
    "战斗任务": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "战斗任务_标题",
                    "战斗任务_已完成"
                ]
            }
        }
    },
    "战斗任务_标题": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    88,
                    592,
                    352,
                    102
                ],
                "expected": "战斗任务"
            }
        }
    },
    "战斗任务_已完成": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": "战斗任务_标题",
                "roi_offset": [
                    85,
                    0,
                    0,
                    0
                ],
                "expected": "已完成",
                "only_rec": true
            }
        }
    },
    "废弃仓库": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "废弃仓库_标题",
                    "废弃仓库_已完成"
                ]
            }
        }
    },
