{
    "兑换码": {
        "next": [
            // 由识别器 CheckRedeemCode 判断要不要兑换
            // 命中（还有码没换）就进「检查是否需要运行」自己的 next 走兑换流程
            // 没命中（没有要换的码）就落到空任务，直接结束
            "[JumpBack]检查是否需要运行",
            "空任务"
        ]
    },
    "检查是否需要运行": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "CheckRedeemCode"
            }
        },
        "next": [
            "[JumpBack]可以输入兑换码",
            "[JumpBack]打开个人页面",
            "[JumpBack]关闭奖励",
            "[JumpBack]返回主菜单"
        ]
    },
    "打开个人页面": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    0,
                    0,
                    236,
                    217
                ],
                "expected": [
                    "等级",
                    "勋阶",
                    "[iI][dD]\\s*[：:]\\s*\\d+"
                ]
            }
        },
        "action": {
            "type": "Click"
        }
    },
    "可以输入兑换码": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    752,
                    468,
                    528,
                    252
                ],
                "expected": "请输入兑换码"
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "RedeemCode",
                "custom_action_param": {
                    //兑换码放在这里
                    "code": [
                        "PUNISHING0924"
                    ]
                }
            }
        }
    },
    "确认兑换": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    1058,
                    395,
                    222,
                    325
                ],
                "expected": "兑换"
            }
        },
        "action": {
            "type": "Click"
        }
    },
    "点击兑换码": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    752,
                    468,
                    528,
                    252
                ],
                "expected": "请输入兑换码"
            }
        },
        "action": {
            "type": "Click"
        }
    }
}
