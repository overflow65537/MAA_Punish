{
    "意外点击_商店物品": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    700,
                    620,
                    120,
                    70
                ],
                "template": "輔助識別/購入.png",
                "threshold": 0.6,
                "green_mask": true
            }
        }
    },
    "错误购买": {
        "recognition": {
            "param": {
                "expected": [
                    "入居許可書",
                    "逆元欠片",
                    "オーバークロック"
                ]
            }
        }
    },
    "打开遣测商店_文字": {
        "recognition": {
            "param": {
                "expected": [
                    "ストア"
                ]
            }
        }
    },
    "购买碎片失败_宿舍": {
        "recognition": {
            "param": {
                "roi": [
                    521,
                    338,
                    450,
                    37
                ],
                "expected": [
                    "購入可能數を超えました"
                ]
            }
        }
    },
    "遣测商店内部_文字": {
        "recognition": {
            "param": {
                "expected": [
                    "ストア"
                ]
            }
        }
    },
    "在宿舍币商店中_文字": {
        "recognition": {
            "param": {
                "expected": [
                    "メダルストア"
                ]
            }
        }
    },
    "购买_宿舍": {
        "recognition": {
            "param": {
                "roi": [
                    310,
                    340,
                    178,
                    39
                ],
                "expected": [
                    "塗装設計図"
                ]
            }
        }
    },
    "点击购买_宿舍": {
        "recognition": {
            "param": {
                "expected": [
                    "購入"
                ]
            }
        }
    },
    "购买成功": {
        "recognition": {
            "param": {
                "roi": [
                    521,
                    338,
                    250,
                    50
                ],
                "expected": [
                    "購入しました"
                ]
            }
        }
    },
    "打开宿舍商店": {
        "recognition": {
            "param": {
                "expected": [
                    "ストア"
                ]
            }
        }
    },
    "选择宿舍币商店_文字": {
        "recognition": {
            "param": {
                "expected": [
                    "メダルストア"
                ]
            }
        }
    },
    "推荐物品": {
        "recognition": {
            "param": {
                "roi": [
                    208,
                    405,
                    999,
                    44
                ],
                "expected": [
                    "購入可能"
                ]
            }
        }
    }
}
